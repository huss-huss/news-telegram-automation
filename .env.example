# Copy to .env and fill in real values. Never commit .env.
# Only non-secret settings and IDs live here. API tokens are stored as n8n credentials
# (Settings -> Credentials), not in environment variables.

# --- n8n runtime ---
# Generate with: openssl rand -hex 32. Keep it stable or stored credentials become unreadable.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
GENERIC_TIMEZONE=UTC
# Workflows read the variables below via $env, which n8n 2.x blocks by default.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Telegram ---
# Chat that receives the news digest (find it with scripts/get-chat-id.sh)
TELEGRAM_CHAT_ID=your_chat_id_here
# Optional: separate chat for failure alerts (defaults to TELEGRAM_CHAT_ID)
TELEGRAM_ALERT_CHAT_ID=

# --- TheNewsAPI query (optional, defaults shown) ---
NEWS_LOCALE=us
NEWS_LANGUAGE=en
NEWS_LIMIT=3
