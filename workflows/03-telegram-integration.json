{
  "name": "03 - Telegram Integration",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.thenewsapi.com/v1/news/top",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "locale",
              "value": "={{ $env.NEWS_LOCALE || 'us' }}"
            },
            {
              "name": "language",
              "value": "={{ $env.NEWS_LANGUAGE || 'en' }}"
            },
            {
              "name": "limit",
              "value": "={{ $env.NEWS_LIMIT || '3' }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "http-request",
      "name": "HTTP Request - News API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpQueryAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "TheNewsAPI token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst body = $input.first().json;\nif (!Array.isArray(body.data)) {\n  throw new Error('Unexpected News API response: missing data[] array');\n}\nconst articles = body.data.filter((a) => a && a.title && a.url);\nconst lines = articles.map((a, i) => `${i + 1}. <a href=\"${esc(a.url)}\">${esc(a.title.trim())}</a>`);\nconst message = `<b>Latest Top Stories</b>\\n\\n${lines.join('\\n')}\\n\\n<i>Source: TheNewsAPI.com</i>`;\nreturn [{ json: { message, totalHeadlines: lines.length, timestamp: new Date().toISOString() } }];"
      },
      "id": "code-node",
      "name": "Process News Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true,
          "parse_mode": "HTML"
        }
      },
      "id": "telegram-node",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        900,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Telegram bot"
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "HTTP Request - News API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request - News API": {
      "main": [
        [
          {
            "node": "Process News Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process News Data": {
      "main": [
        [
          {
            "node": "Send to Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 120,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "pinData": {},
  "versionId": "2"
}
